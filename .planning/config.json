{
  "model_profile": "quality",
  "commit_docs": true,
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": true,
    "nyquist_validation": true,
    "pattern_mapper": true,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "tdd_mode": true,
    "code_review": true,
    "code_review_depth": "deep",
    "ui_review": true,
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": true,
    "use_worktrees": true,
    "plan_bounce": true,
    "subagent_timeout": 1200,
    "max_discuss_passes": 5,
    "auto_prune_state": true
  },
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true,
    "auto_update": true
  },
  "git": {
    "branching_strategy": "none",
    "quick_branch_template": null,
    "create_tag": true
  },
  "hooks": {
    "context_warnings": true,
    "workflow_guard": true
  },
  "model_policy": {
    "provider": null,
    "budget": null,
    "high": null,
    "medium": null,
    "low": null
  }
}
